                        <span className="text-slate-500 ml-1">(根目录)</span>
                      </div>
                    </div>
                    {[
                      { key: 'recordings', branch: '|--', color: 'text-yellow-300', label: '常规录像分段', desc: '每30秒一段，按设备ID分文件夹存储' },
                      { key: 'alarm_videos', branch: '|--', color: 'text-red-300', label: '告警视频', desc: 'AI检测到异常时自动保存的片段' },
                      { key: 'playback_videos', branch: '|--', color: 'text-purple-300', label: '常态化回放', desc: '按小时窗口合并的归档视频' },
                      { key: 'temp_cache', branch: '|--', color: 'text-blue-300', label: '临时缓存', desc: '手动触发的临时录像，自动清理旧文件' },
                      { key: 'alarm_screenshots', branch: '`--', color: 'text-green-300', label: '告警截图', desc: '告警发生时自动截取的图片' },
                    ].map(item => (
