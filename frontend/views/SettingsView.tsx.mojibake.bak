                        <span className="text-cyan-400 shrink-0">{item.branch}</span>
                        <div>
                          <div className="flex items-center gap-1">
                            <input
                              value={getVideoStorageFolder(item.key as keyof SystemSettings['videoStorageFolders'])}
                              onChange={(e) => updateVideoStorageFolder(item.key as keyof SystemSettings['videoStorageFolders'], e.target.value)}
                              className={`w-40 bg-transparent border-b border-slate-600/80 px-0.5 py-0 text-xs font-mono outline-none focus:border-cyan-400 ${item.color}`}
                            />
