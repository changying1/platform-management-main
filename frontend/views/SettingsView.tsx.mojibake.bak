                            onChange={(e) => setSettings({ ...settings, alarmRepeatInterval: Number(e.target.value) })}
                            min={1}
                            max={30}
                            className="w-full bg-slate-800 border border-slate-700 rounded-lg px-3 py-1.5 text-sm text-slate-200"
